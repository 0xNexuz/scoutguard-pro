{
  "name": "scoutguard-pro",
  "version": "1.0.0",
  "description": "Pre-execution security oracle and policy firewall for autonomous AI payment agents using Blockscout PRO API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tailwindcss -i public/styles.src.css -o public/styles.css --minify",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "demo:agent": "tsx examples/mock-agent.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.verify.json",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "keywords": [
    "blockscout",
    "security",
    "ai-agents",
    "finops",
    "address-poisoning",
    "web3"
  ],
  "author": "ScoutGuard Team",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
