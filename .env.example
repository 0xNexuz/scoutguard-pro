# Required for production (confirmed Vercel previews may omit it; protected access still denies).
# Supply a long, random secret outside Git.
SCOUTGUARD_SERVICE_KEY=
# The service key authorizes exactly this policy identity (defaults to procurement-bot-01).
# Use a separate deployment/key if another agent needs a different policy.
SCOUTGUARD_AGENT_ID=procurement-bot-01
# Required for Blockscout PRO gateway requests. Without it the service uses public explorer endpoints.
BLOCKSCOUT_API_KEY=
PORT=3030
